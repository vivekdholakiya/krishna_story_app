# Copy this file to .env and fill in your real Cloudflare R2 credentials.
# .env is gitignored. Never commit the real file.

# From: R2 dashboard -> top right ("Account ID")
R2_ACCOUNT_ID=your_cloudflare_account_id_here

# Bucket you created in R2
R2_BUCKET=krishna-stories-audio

# From: R2 dashboard -> Manage R2 API Tokens -> Create API token
# Scope: Object Read & Write, restrict to the bucket above
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# From: Bucket -> Settings -> Public Access -> Allow Access
# Looks like https://pub-xxxxxxxxxxxxxxxxx.r2.dev
# Optional: only used to print sample URLs after upload
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxx.r2.dev
